@model IEnumerable<UserManageGroupsViewModel>

@{
    ViewData["Title"] = "Grupe";
}

<h2>Grupe</h2>

<p>
    <a class="group-link float-end" asp-controller="Group" asp-action="CreateGroup">Kreiraj novu grupu</a>
</p>

<table class="table" id="groupTable">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.TotalOfNumbers)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.TotalOfNumbers)</td>
                <td>
                    <a class="group-link" asp-controller="Group" asp-action="Numbers" asp-route-id="@item.GroupID">Lista brojeva</a>
                    @if (!item.isDefault)
                    {
                        <text> | </text>
                        <a class="group-link" asp-controller="Group" asp-action="EditGroup" asp-route-id="@item.GroupID">Izmeni</a>
                        <text> | </text>
                        <a href="#" class="group-link js-delete-group" data-group-id="@item.GroupID">Obriši</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#groupTable").DataTable({
                dom: "<'row'<'col-sm-12 col-md-6'f>>rt<'row'<'col-sm-12'p>>",
                language: {
                    search: "Pretraga:",
                    searchPlaceholder: "",
                    zeroRecords: "Nema rezultata",
                    emptyTable: "Nema podataka u tabeli",
                    paginate: {
                        first: "Prva",
                        last: "Poslednja",
                        next: "Sledeća",
                        previous: "Prethodna"
                    }
                },
                stateSave: true,
                pageLength: 10,
                info: false,
                columnDefs: [
                    { targets: 2, orderable: false, searchable: false }
                ],
                initComplete: function () {
                    $("div.dataTables_filter input").trigger("focus").trigger("select");
                }
            });

            // Brisanje grupe: DELETE /api/user/deletegroup/{id} (UserApiController).
            $("#groupTable").on("click", ".js-delete-group", function (e) {
                e.preventDefault();
                if (!confirm("Da li ste sigurni da želite da obrišete grupu?")) return;
                var link = $(this);
                var id = link.attr("data-group-id");
                $.ajax({ url: "/api/user/deletegroup/" + id, method: "DELETE" })
                    .done(function () {
                        link.parents("tr").fadeOut(function () { $(this).remove(); });
                    })
                    .fail(function () { alert("Greška prilikom brisanja."); });
            });
        });
    </script>
}
