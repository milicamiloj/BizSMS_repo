@{
    ViewData["Title"] = "Učitaj listu brojeva";
    var groupId = ViewContext.RouteData.Values["id"];
}

<h1>Učitaj listu brojeva</h1>
<h2>Grupa: @ViewBag.GroupName</h2>

<form asp-action="CheckUploadedNumbers" asp-route-id="@groupId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <a class="group-link" asp-action="DownloadTemplate">Skini šablon</a>
    </div>

    <div class="mb-3">
        <label class="form-label" for="fileSelected">Izaberi fajl</label>
        <input type="file" name="file" id="fileSelected" class="form-control" />
    </div>

    <button type="submit" id="importFileButton" class="btn btn-primary" disabled="disabled">Učitaj fajl</button>
</form>

<div class="mt-3">
    <a class="group-link" asp-action="Numbers" asp-route-id="@groupId">Nazad na listu</a>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#fileSelected").on("change", function () {
                $("#importFileButton").removeAttr("disabled");
            });
        });
    </script>
}
