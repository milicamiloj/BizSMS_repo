@model UserEditNumberViewModel

@{
    ViewData["Title"] = "Izmena informacija o broju";
}

<h2>Izmena informacija o broju</h2>

<hr />

<form asp-action="EditNumber" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="NumberID" />
    <input type="hidden" asp-for="GroupID" />

    <div class="mb-3">
        <label asp-for="Number" class="form-label"></label>
        <p class="form-control-plaintext">@Html.DisplayFor(model => model.Number)</p>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Snimi</button>
</form>

<div class="mt-3">
    <a class="group-link" asp-action="Numbers" asp-route-id="@Model.GroupID">Nazad na listu</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
