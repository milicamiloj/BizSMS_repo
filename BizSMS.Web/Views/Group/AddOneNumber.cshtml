@model UserAddOneNumberViewModel

@{
    ViewData["Title"] = "Dodaj broj u grupu:";
}

<h2>Dodaj broj u grupu: @ViewBag.GroupName</h2>

@if (!String.IsNullOrEmpty(ViewBag.SendDeniedNumber) || !String.IsNullOrEmpty(ViewBag.BadNumbers) || !String.IsNullOrEmpty(ViewBag.BadGroup) || !String.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>

        @if (!String.IsNullOrEmpty(ViewBag.SendDeniedNumber))
        {
            <p>Broj/brojevi koje nije moguće dodati jer su se odjavili sa liste primaoca SMS poruka:  @ViewBag.SendDeniedNumber</p>
        }
        @if (!String.IsNullOrEmpty(ViewBag.BadNumbers))
        {
            <p>Brojevi lošeg fomata: @ViewBag.BadNumbers</p>
        }
        @if (!String.IsNullOrEmpty(ViewBag.BadGroup))
        {
            <p>Brojevi koji ne mogu pripadati odabranoj grupi: @ViewBag.BadGroup</p>
        }
        @if (!String.IsNullOrEmpty(ViewBag.Message))
        {
            <p>Došlo je do greške, probajte ponovo kasnije. Ako se problem ponovi kontaktirajte Vašeg administratora. @ViewBag.Message</p>
        }
    </div>
    <hr />
}

<form asp-action="AddOneNumber" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="GroupID" />

    <div class="mb-3">
        <label asp-for="Number" class="form-label"></label>
        <input asp-for="Number" class="form-control" id="Number" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NameNumber" class="form-label"></label>
        <input asp-for="NameNumber" class="form-control" />
        <span asp-validation-for="NameNumber" class="text-danger"></span>
    </div>

    <button type="submit" id="insertNumberButton" class="btn btn-primary" disabled="disabled">Dodaj</button>
</form>

<div class="mt-3">
    <a class="group-link" asp-action="Numbers" asp-route-id="@Model.GroupID">Nazad na listu</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $("#Number").on("input", function () {
                if ($("#Number").val()) {
                    $("#insertNumberButton").removeAttr("disabled");
                } else {
                    $("#insertNumberButton").attr("disabled", "disabled");
                }
            });
        });
    </script>
}
