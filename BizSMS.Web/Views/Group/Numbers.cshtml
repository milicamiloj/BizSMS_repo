@{
    ViewData["Title"] = "Lista brojeva";
    var groupId = ViewContext.RouteData.Values["id"];
}

<h2>Lista brojeva za grupu: @ViewBag.GroupName</h2>

@if (!String.IsNullOrEmpty(ViewBag.ExistingNumbers) || !String.IsNullOrEmpty(ViewBag.BadNumbers) || !String.IsNullOrEmpty(ViewBag.BadGroup))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>

        @if (!String.IsNullOrEmpty(ViewBag.ExistingNumbers))
        {
            <p>Sledeći broj/brojevi već postoje u ovoj grupi: @ViewBag.ExistingNumbers</p>
        }
        @if (!String.IsNullOrEmpty(ViewBag.BadNumbers))
        {
            <p>Brojevi lošeg fomata: @ViewBag.BadNumbers</p>
        }
        @if (!String.IsNullOrEmpty(ViewBag.BadGroup))
        {
            <p>Brojevi koji ne mogu pripadati odabranoj grupi: @ViewBag.BadGroup</p>
        }
    </div>
    <hr />
}

<p>
    @if (!(bool)ViewBag.isDefaultGroup)
    {
        <a class="group-link float-end" asp-action="AddNumber" asp-route-id="@groupId">Dodaj broj/brojeve iz VPN grupe</a>
        <span class="float-end">&nbsp;|&nbsp;</span>
        <a class="group-link float-end" asp-action="UploadNumbers" asp-route-id="@groupId">Učitaj listu brojeva</a>
        <span class="float-end">&nbsp;|&nbsp;</span>
        <a class="group-link float-end" asp-action="AddOneNumber" asp-route-id="@groupId">Dodaj jedan broj</a>
    }
</p>

<table class="table" id="numbersTable">
    <thead>
        <tr>
            <th>Broj</th>
            <th>Naziv</th>
            <th>Tip broja</th>
            <th></th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div>
    <a class="group-link" asp-action="Index">Nazad na grupe</a>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            // Tabelu puni /api/Group/GetNumbers/{id} (GroupApiController).
            $("#numbersTable").DataTable({
                dom: "<'row'<'col-sm-12 col-md-6'f>>rt<'row'<'col-sm-12'ip>>",
                ajax: "/api/Group/GetNumbers/@groupId",
                // Korisnički podaci se prikazuju kao tekst (zaštita od XSS-a); HTML je samo EditLink sa servera.
                columns: [
                    { data: "Number", render: $.fn.dataTable.render.text() },
                    { data: "Name", render: $.fn.dataTable.render.text() },
                    { data: "NumberType", render: $.fn.dataTable.render.text() },
                    { data: "EditLink", orderable: false, searchable: false }
                ],
                language: {
                    search: "Pretraga:",
                    searchPlaceholder: "",
                    zeroRecords: "Nema rezultata",
                    emptyTable: "Nema podataka u tabeli",
                    info: "Prikazano _START_ - _END_ od _TOTAL_",
                    infoEmpty: "Prikazano 0 - 0 od 0",
                    infoFiltered: "(filtrirano iz _MAX_ ukupno)",
                    paginate: { first: "Prva", last: "Poslednja", next: "Sledeća", previous: "Prethodna" }
                },
                initComplete: function () {
                    $("div.dataTables_filter input").trigger("focus").trigger("select");
                }
            });

            // Brisanje broja: DELETE /api/user/removenumberfromgroup (UserApiController).
            $("#numbersTable").on("click", ".js-delete-number", function (e) {
                e.preventDefault();
                if (!confirm("Da li ste sigurni da želite da obrišete izabrani broj?")) return;
                var link = $(this);
                $.ajax({
                    url: "/api/user/removenumberfromgroup/",
                    data: { GroupID: link.attr("data-group-id"), NumberID: link.attr("data-number-id") },
                    method: "DELETE"
                })
                    .done(function () {
                        link.parents("tr").fadeOut(function () { $(this).remove(); });
                        alert("Broj je izbrisan iz grupe!");
                        location.reload(true);
                    })
                    .fail(function () { alert("Greška prilikom brisanja."); });
            });
        });
    </script>
}
