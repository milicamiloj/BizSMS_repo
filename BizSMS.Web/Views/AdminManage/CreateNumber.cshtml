@model BizSMS.Web.Models.AdminCreateNumberViewModel

@{
    ViewData["Title"] = "Dodaj broj";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateNumber" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="GroupID" />
            <input type="hidden" asp-for="ClientID" />

            <div class="mb-3">
                <label asp-for="NumberTypeID" class="form-label"></label>
                <select asp-for="NumberTypeID" asp-items="Model.NumberType" class="form-control">
                    <option value="">Tip broja</option>
                </select>
                <span asp-validation-for="NumberTypeID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Number" class="form-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="SendAllowed" class="form-check-input" />
                <label asp-for="SendAllowed" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Kreiraj</button>
            <a class="group-link ms-2" asp-action="Numbers" asp-route-id="@Model.ClientID">Nazad</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
