@model BizSMS.Web.Models.CreateMessageCostViewModel

@{
    ViewData["Title"] = "Dodaj cenu poruka";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateMessageCost" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NumberTypeID" class="form-label"></label>
                <select asp-for="NumberTypeID" asp-items="Model.NumberTypes" class="form-control">
                    <option value="">Izaberite tip broja</option>
                </select>
                <span asp-validation-for="NumberTypeID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumberOfMessagesFrom" class="form-label"></label>
                <input asp-for="NumberOfMessagesFrom" class="form-control" />
                <span asp-validation-for="NumberOfMessagesFrom" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumberOfMessagesTo" class="form-label"></label>
                <input asp-for="NumberOfMessagesTo" class="form-control" />
                <span asp-validation-for="NumberOfMessagesTo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" placeholder="x,xxx" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Kreiraj</button>
            <a class="group-link ms-2" asp-action="MessageCost">Nazad</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
