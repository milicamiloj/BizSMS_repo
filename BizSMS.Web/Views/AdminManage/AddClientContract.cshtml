@model BizSMS.Web.Models.AddClientContractViewModel

@{
    ViewData["Title"] = "Dodaj ugovor";
}

<h2>@ViewData["Title"]</h2>
<h4>Naziv klijenta: @Model.ClientName</h4>

<div class="row">
    <div class="col-md-6">
        <form asp-action="AddClientContract" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientName" />

            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>
                <input asp-for="ContractId" class="form-control" />
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sačuvaj</button>
            <a class="group-link ms-2" asp-action="ClientContracts" asp-route-id="@Model.ClientId">Nazad</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
