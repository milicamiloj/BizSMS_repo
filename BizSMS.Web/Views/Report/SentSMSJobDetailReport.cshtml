@model IEnumerable<BizSMS.Web.Models.SentSMSJobDetailReportViewModel>

@{
    ViewData["Title"] = "Detalji poslate SMS poruke";
}

<h2>@ViewData["Title"] za @ViewBag.ClientName</h2>

<table class="table" id="detailReportTable">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Number)</th>
            <th>@Html.DisplayNameFor(model => model.NumberTypeName)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.MessageText)</th>
            <th>@Html.DisplayNameFor(model => model.MessageLength)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.Delivered)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Number)</td>
                <td>@Html.DisplayFor(modelItem => item.NumberTypeName)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td style="max-width: 400px; word-break: break-all; overflow-wrap: break-word;">@Html.DisplayFor(modelItem => item.MessageText)</td>
                <td class="text-center">@Html.DisplayFor(modelItem => item.MessageLength)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@Html.DisplayFor(modelItem => item.Delivered)</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a class="group-link" asp-action="SentSmsClientList">Nazad</a>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/buttons.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/datatables/js/jszip.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables/js/buttons.bootstrap5.min.js"></script>
    <script src="~/lib/datatables/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables/js/buttons.print.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#detailReportTable").DataTable({
                dom: "<'row'<'col-sm-12 col-md-6'B><'col-sm-12 col-md-6'f>>rt<'row'<'col-sm-12'p>>",
                buttons: [
                    {
                        extend: "excel",
                        text: "Excel",
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5, 6],
                            // Kolona Broj (0) kao tekst (ZWNJ prefiks) — da Excel ne odseče vodeće nule / ne pretvori u broj.
                            format: { body: function (data, row, column) { return column === 0 ? String.fromCharCode(0x200C) + data : data; } }
                        }
                    },
                    { extend: "print", text: "Štampaj", exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] } }
                ],
                pageLength: 10,
                info: false,
                language: {
                    search: "Pretraga:",
                    searchPlaceholder: "",
                    zeroRecords: "Nema rezultata",
                    emptyTable: "Nema podataka u tabeli",
                    paginate: { first: "Prva", last: "Poslednja", next: "Sledeća", previous: "Prethodna" }
                },
                initComplete: function () {
                    $("div.dataTables_filter input").trigger("focus").trigger("select");
                }
            });
        });
    </script>
}
