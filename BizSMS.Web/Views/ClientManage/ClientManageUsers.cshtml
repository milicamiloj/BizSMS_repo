@model IEnumerable<BizSMS.Web.Models.ClientManageUsersViewModel>

@{
    ViewData["Title"] = "Upravljaj korisnicima";
}

<h2>@ViewData["Title"]</h2>
<p class="text-success">@ViewBag.StatusMessage</p>

<table class="table" id="clientTable">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>
                    <a class="group-link" asp-action="ClientEditUser" asp-route-id="@item.UserID">Izmeni</a>
                    <text> | </text>
                    @* Napomena: legacy je ovde imao i "Reset lozinke" (Account/ResetPassword) — ta akcija još nije portovana. *@
                    <a href="#" class="group-link js-delete-user" data-user-id="@item.UserID">Obriši</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#clientTable").DataTable({
                dom: "<'row'<'col-sm-12 col-md-6'f>>rt<'row'<'col-sm-12'p>>",
                pageLength: 10,
                info: false,
                columnDefs: [{ targets: 2, orderable: false, searchable: false }],
                language: {
                    search: "Pretraga:",
                    searchPlaceholder: "",
                    zeroRecords: "Nema rezultata",
                    emptyTable: "Nema podataka u tabeli",
                    paginate: { first: "Prva", last: "Poslednja", next: "Sledeća", previous: "Prethodna" }
                },
                initComplete: function () {
                    $("div.dataTables_filter input").trigger("focus").trigger("select");
                }
            });

            // Meko brisanje korisnika: DELETE /api/ClientManage/Cancel/{id} (ClientManageApiController).
            $("#clientTable").on("click", ".js-delete-user", function (e) {
                e.preventDefault();
                if (!confirm("Da li ste sigurni da želite da obrišete izabranog korisnika?")) return;
                var link = $(this);
                $.ajax({ url: "/api/ClientManage/Cancel/" + link.attr("data-user-id"), method: "DELETE" })
                    .done(function () {
                        link.parents("tr").fadeOut(function () { $(this).remove(); });
                    })
                    .fail(function () { alert("Greška prilikom brisanja."); });
            });
        });
    </script>
}
