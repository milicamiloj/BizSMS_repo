@model LoginViewModel
@{
    ViewData["Title"] = "Prijava";
}

<h2>@ViewData["Title"]</h2>
<div class="row">
    <div class="col-md-6">
        <section id="loginForm">
            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" role="form">
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autofocus />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Prijava</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('sessionExpired') === 'true') {
                alert("Vaša sesija je istekla. Molimo prijavite se ponovo.");
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        });
    </script>
}
