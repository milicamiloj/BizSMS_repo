<?xml version="1.0" encoding="utf-8"?>
<!-- Publish (dotnet publish) sam dopisuje aspNetCore handler; ovde su samo IIS bezbednosna podešavanja. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <!-- IIS 10+: ne šalje "Server: Microsoft-IIS/10.0". -->
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
