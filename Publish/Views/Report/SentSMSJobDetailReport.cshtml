@model IEnumerable<BizSMS.Models.SentSMSJobDetailReportViewModel>

@{
    ViewBag.Title = Resources.Resources.SMSReportDetail;
    var culture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.ToLowerInvariant();
}

<h2>@ViewBag.Title @Resources.Resources.For.ToLower() @ViewBag.ClientName</h2>

<table class="table" id="detailReportTable" data-language="@culture">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MessageText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MessageLength)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Delivered)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Number)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumberTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td style="max-width: 400px; height:auto; word-break: break-all; overflow-wrap: break-word;">
                @Html.DisplayFor(modelItem => item.MessageText)
            </td>
            <td style="text-align: center">
                @Html.DisplayFor(modelItem => item.MessageLength)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Delivered)
            </td>
        </tr>
        }
    </tbody>
</table>

<div>
    @Html.ActionLink(Resources.Resources.Back, "SentSMSJobReport", new { id = Convert.ToInt32(HttpContext.Current.Request.QueryString["clientId"]) })
</div>

@section styles {
    @Styles.Render("~/Content/datatable")
}


@section scripts {
    @Scripts.Render("~/bundles/jquery-datatables")
    @Scripts.Render("~/bundles/jquery-datatables-buttons")

    <script>
        $(document).ready(function () {
            var buttonCommon = {
                exportOptions: {
                    format: {
                        body: function (data, row, column, node) {
                            return column === 0 ?
                                '\u200C' + data :
                                data;
                        }
                    }
                }
            };

            var table_link = $("#detailReportTable");
            var table = table_link.DataTable({
                dom: '<"pull-left"f>r<"pull-right"B>tip',
                buttons: [
                    $.extend(true, {}, buttonCommon, {
                        extend: 'excel',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5, 6]
                        }
                    }),
                    {
                        extend: 'print',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5, 6]
                        }
                    }
                ],
                oLanguage: {
                    "sUrl": "/Content/localization/" + "dt-" + table_link.attr("data-language") + ".json"
                },
                "aoColumns": [
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null
                ],
                "iDisplayLength": 10,
                "info": false,
                "initComplete": function (settings, json) {
                    $('div.dataTables_filter input').focus().select();
                }
            });
        });
    </script>
}