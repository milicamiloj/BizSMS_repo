@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = @Resources.Resources.Error;
}

<div class="jumbotron">
    <div class="container">
        <h3 class="pull-right">@Resources.Resources.Error</h3>
        <h1>@Resources.Resources.Hello,</h1> <h2> @Resources.Resources.ErrorMessage :)</h2>
        <h3><a href="/Home/Index">@Resources.Resources.BackToHomePage</a></h3>
    </div>
</div>