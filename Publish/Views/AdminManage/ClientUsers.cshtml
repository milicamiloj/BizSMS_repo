@model IEnumerable<BizSMS.Models.ClientUsersViewModel>

@{
    ViewBag.Title = @Resources.Resources.ManageUsers;
    var culture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.ToLowerInvariant();
}

@if (!string.IsNullOrEmpty((string)TempData["StatusMessage"]))
{
    <p class="alert alert-success fade in">
        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
        @TempData["StatusMessage"].ToString()
    </p>
}

<link href="/Content/PagedList.css" rel="stylesheet" type="text/css" />

<h2>@Resources.Resources.ManageUsers</h2>
<h2>@Resources.Resources.ClientName: @ViewBag.ClientName</h2>
<p class="text-success">@ViewBag.StatusMessage</p>
<p>
    @if (Model.Count() < 5)
    {
        @Html.ActionLink(Resources.Resources.CreateUser, "CreateUser", new { id = ViewContext.RouteData.Values["id"] }, htmlAttributes: new { @class = "pull-right" })
    }
</p>

<table class="table" id="clientTable" data-language="@culture">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Username)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.ActionLink(Resources.Resources.Edit, "EditUser", new { id = item.UserID }) |
                    @Html.ActionLink(Resources.Resources.ResetPassword, "ResetPassword", "Account", new { id = item.UserID }, htmlAttributes: null) |
                    <a href="#" class="js-delete-user"
                       data-yes="@Resources.Resources.Yes"
                       data-no="@Resources.Resources.No"
                       data-question="@Resources.Resources.QuestionDeleteUser"
                       data-user-id="@item.UserID">
                        @Resources.Resources.Delete
                    </a>
                </td>
            </tr>

        }
    </tbody>
</table>

<p>
    @Html.ActionLink(Resources.Resources.BackToList, "ManageClients")
</p>

