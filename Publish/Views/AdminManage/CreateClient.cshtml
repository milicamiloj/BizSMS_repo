<script>
        $(document).ready(function () {

            $("#PhoneNumber").on("change", function(){
                $("#PhoneNumber").val($.trim($("#PhoneNumber").val().replace("381", "0")));
            })

            $("#Username").on("change", function(){
                $("#Username").val($.trim($("#Username").val()));
            })

        })
</script>
