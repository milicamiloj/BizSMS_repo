@model BizSMS.Models.AlphanumericCreateViewModel

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>@Resources.Resources.Alphanumeric (<span style="font-size:small" class="text-success">@Resources.Resources.AlphanumericRegExValidation</span>)</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.ClientID)

        <div class="form-group">
            @Html.LabelFor(model => model.Alphanumeric, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Alphanumeric, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Alphanumeric, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="@Resources.Resources.Create" class="btn btn-default" />
                @Html.ActionLink(Resources.Resources.Cancel, "Alphanumerics", routeValues: new { id = Model.ClientID }, htmlAttributes: new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jquery-validate-unobtrusive")    

