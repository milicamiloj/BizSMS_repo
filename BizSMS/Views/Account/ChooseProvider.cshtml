@using BizSMS.Models
@model ChooseProviderModel

<h1>Choose Provider</h1>
<hr />
@*@using (Html.BeginForm("ChooseProvider", "Account", FormMethod.Post))*@
@using (Html.BeginForm("ChooseProvider", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post))
{
    @Html.AntiForgeryToken() <!-- Dodavanje AntiForgeryToken -->
    @Html.Hidden("rememberMe", @Model.RememberMe)
    @*<p>Provider: @Html.DropDownListFor(x => x.ChosenProvider, Model.Providers.Select(x => new SelectListItem { Value = x, Text = x }).ToList())</p>*@
    <p>Provider:  @Html.DropDownListFor(model => model.SelectedProvider, Model.Providers)</p>
    <input class="btn" value="Submit" type="submit" />
}
