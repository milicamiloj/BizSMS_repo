@model BizSMS.Models.AdminConfirmUploadFileViewModel

@{
    ViewBag.Title = "UploadNumbers";
}

<h2>UploadNumbers</h2>
<h1>@ViewBag.Count</h1>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Numbers[0].Number)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Numbers[0].NumberType)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model.Numbers) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Number)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NumberType)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
        </td>
    </tr>
}

</table>
